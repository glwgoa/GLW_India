NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Required for the Employees
# "Add employee" feature (creates real Supabase Auth users as admin).
# Supabase Dashboard → Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — Google Ads page (Google Ads → sidebar). Leave blank until connected.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Auth (pick one): service account key as a file path (local) or the whole JSON (Vercel), or OAuth below
GOOGLE_ADS_JSON_KEY_FILE_PATH=
GOOGLE_ADS_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Only if the account sits under a manager (MCC) account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
